# Neurovex settings. Copy to `.env` to override defaults. Every key is optional.
# On your PC, keep API keys in the OS keychain:  uv run nvx secrets set PUKU_API_KEY
# On a server, set them as environment variables and NEUROVEX_USE_KEYRING=false.

# --- Core ---------------------------------------------------------------------
# NEUROVEX_PROFILE=dev                  # dev | test | prod (prod = JSON logs)
# NEUROVEX_DATA_DIR=                    # default: %LOCALAPPDATA%\Neurovex (~/.local/share/Neurovex on Linux)
# NEUROVEX_LOG_LEVEL=INFO
# NEUROVEX_HOST=127.0.0.1               # localhost only; anything else needs ALLOW_REMOTE
# NEUROVEX_PORT=8765
# NEUROVEX_ALLOW_REMOTE=false           # no auth yet (P0.3): only behind an authenticating proxy
# NEUROVEX_ALLOWED_HOSTS=               # extra addresses for the page, e.g. pc.tail1234.ts.net (Tailscale)
# NEUROVEX_USE_KEYRING=true             # false on servers (no OS keychain)
# NEUROVEX_API_TOKEN=                   # for scripts; made on first start if unset (keychain, or data dir file)

# NEUROVEX_TIMEZONE=Asia/Dhaka           # your time zone; set it on servers (they usually run in UTC)
# NEUROVEX_TODAY_BRIEF_TIME=08:00       # announce the day's brief on open pages; empty = never

# NEUROVEX_BACKUP_KEEP=7                # daily database backups to keep; 0 = no backups
# NEUROVEX_BACKUP_DIR=                  # default: <data dir>\backups; a synced folder keeps a copy off this PC

# --- AI provider keys -------------------------------------------------------------------
# The default is Puku only. Other providers below are optional: their keys are only used
# if you add them to NEUROVEX_LLM_PROVIDERS.
# PUKU_API_KEY=                         # Puku AI gateway (api.sdk.puku.sh), plan-based monthly quota
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=                       # GOOGLE_API_KEY also works
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# HF_TOKEN=                             # Hugging Face (Inference Providers permission)
# ANTHROPIC_API_KEY=                    # optional, paid; add "anthropic" to the provider list

# --- X (Twitter) accounts: free, no key needed ------------------------------------------
# NEUROVEX_X_REFRESH_MINUTES=30         # accounts that posted today; quieter ones up to 12x less often
# NEUROVEX_X_MAX_POSTS_PER_CHECK=5      # new posts per account per check (each costs one summary)
# NEUROVEX_X_NITTER_URL=                # optional: read timelines through your own Nitter server

# --- AI routing --------------------------------------------------------------------
# Order = priority. Default: puku. Optional ids: groq, cerebras, gemini, mistral, openrouter,
# cloudflare, huggingface, anthropic (paid), ollama (local dev only).
# NEUROVEX_LLM_PROVIDERS=puku
# NEUROVEX_LLM_STRATEGY=priority        # priority (best first, overflow under load) | round_robin
# NEUROVEX_LLM_TIMEOUT_S=60
# NEUROVEX_LLM_MAX_CONCURRENCY=         # per provider; default from the catalog (1–2)

# Model per provider (defaults in neurovex/llm/catalog.py; list options: nvx llm models <id>)
# NEUROVEX_CEREBRAS_MODEL=gpt-oss-120b
# NEUROVEX_GROQ_MODEL=openai/gpt-oss-120b
# NEUROVEX_GEMINI_MODEL=gemini-3.8-flash
# NEUROVEX_MISTRAL_MODEL=mistral-small-latest
# NEUROVEX_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# NEUROVEX_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# NEUROVEX_HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
# NEUROVEX_PUKU_MODEL=puku-ai-2.8      # or puku-ai-2.7
# NEUROVEX_ANTHROPIC_MODEL=claude-haiku-5-5
# NEUROVEX_OLLAMA_MODEL=qwen2.5
# NEUROVEX_OLLAMA_URL=http://localhost:11434

# --- News module ----------------------------------------------------------------
# NEUROVEX_NEWS_LLM_PROVIDER=auto       # auto (the chain above) | none (headlines only) | one provider id
# NEUROVEX_NEWS_AUTO_REFRESH=true
# NEUROVEX_NEWS_REFRESH_MINUTES=10      # feeds use conditional GET, so frequent checks are cheap
# NEUROVEX_NEWS_MAX_AGE_DAYS=3          # ignore feed entries older than this
# NEUROVEX_NEWS_MAX_NEW_PER_SOURCE=30
# NEUROVEX_NEWS_MAX_SUMMARIES_PER_RUN=25        # cloud providers
# NEUROVEX_NEWS_MAX_SUMMARIES_PER_RUN_LOCAL=6   # only if every provider is local (Ollama)
# NEUROVEX_NEWS_MAX_ATTEMPTS=3
# NEUROVEX_NEWS_FETCH_FULL_TEXT=true    # fetch the page when the feed excerpt is thin
# NEUROVEX_NEWS_RETENTION_DAYS=30       # bookmarked articles are kept forever

# --- News: personal layer -------------------------------------------------------------
# NEUROVEX_NEWS_BREAKING_IMPORTANCE=8   # alert at this importance (or >=6 if you follow the topic)
# NEUROVEX_NEWS_BREAKING_MAX_AGE_HOURS=12
# NEUROVEX_NEWS_BRIEFING_AUTO=true      # write a personal briefing after refreshes
# NEUROVEX_NEWS_BRIEFING_STALE_HOURS=4  # ...at most this often
# NEUROVEX_NEWS_BRIEFING_SIZE=6         # stories per briefing
